# Where the HR API is
API_URL=http://localhost:4000/api/v1

# Must match SERVICE_API_KEY in api/.env
SERVICE_API_KEY=change-me-to-a-long-random-string

# How often to check for contracts that need a reminder
CHECK_INTERVAL_MINUTES=60

# SMTP settings. Leave SMTP_HOST empty to print emails to the console instead.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, and an App Password
# (Google Account → Security → 2-Step Verification → App passwords) as SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="HR Admin <hr@yourcompany.com>"
