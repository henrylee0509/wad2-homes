# Port the API listens on
PORT=4000

# SQLite database file (created automatically)
DATABASE_FILE=data/hr.db

# Web app origin(s) allowed to call the API, comma separated
CORS_ORIGINS=http://localhost:5173

# Public URL of the web app, used for links in reminder emails
WEB_URL=http://localhost:5173

# Shared secret the notifier service uses to call /api/v1/internal/*. Use a long random string,
# and put the same value in notifier/.env
SERVICE_API_KEY=change-me-to-a-long-random-string

# Secret for signing login tokens (optional: one is generated and stored if left empty)
SESSION_SECRET=

# First admin account, created on first start
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=ChangeMe123!

# Add demo departments and employees on first start
SEED_DEMO_DATA=true

# Time zone used for "today" when checking contract dates
TIMEZONE=Asia/Singapore
